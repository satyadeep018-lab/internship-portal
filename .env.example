# Copy to .env (optional). Never commit .env. No real secrets belong in this file.
PORT=3000
DB_PATH=data/internships.db

# Needed only for create, update and delete of internships. Leave empty to disable those routes.
# Make a long random value for your own .env: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# Rate limits (requests per window, per IP address)
RATE_LIMIT_MAX=100
APPLY_RATE_LIMIT_MAX=10

# Set to 1 only when running behind one trusted reverse proxy (most hosts)
TRUST_PROXY=0
